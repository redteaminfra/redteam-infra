[Unit]
Description=Barragan dev/test FastAPI API
After=network-online.target

[Service]
EnvironmentFile=-/etc/barragan/barragan.env
Type=simple
User=barragan
Group=barragan
WorkingDirectory=/opt/redteam-infra/barragan/backend
Environment=PYTHONUNBUFFERED=1
Environment=BARRAGAN_ENV=devtest
Environment=BARRAGAN_HOST=127.0.0.1
Environment=BARRAGAN_PORT=5001
Environment=BARRAGAN_SERVE_FRONTEND=0
Environment=BARRAGAN_START_SCHEDULERS=0
Environment=BARRAGAN_AUTH_REQUIRED=1
Environment=BARRAGAN_AUTH_SESSION_COOKIE_NAME=barragan_devtest_session
Environment=BARRAGAN_AUTH_COOKIE_SECURE=0
Environment=BARRAGAN_DATA_DIR=/var/lib/barragan/devtest-data
Environment=BARRAGAN_OCI_COMPUTE_PROFILES_FILE=/var/lib/barragan/config/oci-compute-profiles.json
Environment=BARRAGAN_PROVIDER_RECONCILIATION_LIVE=false
Environment=BARRAGAN_CREDENTIAL_MASTER_KEY_FILE=/var/lib/barragan/secrets/credential-master.key
Environment=BARRAGAN_VALIDATION_SSH_PRIVATE_KEY=/var/lib/barragan/.ssh/barragan_testing
Environment=BARRAGAN_VALIDATION_SSH_PUBLIC_KEY=/var/lib/barragan/.ssh/barragan_testing.pub
Environment=OCI_CLI_PATH=/var/lib/barragan/.local/bin/oci
ExecStart=/opt/redteam-infra/barragan/backend/.venv/bin/uvicorn app.asgi:app --host 127.0.0.1 --port 5001
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
