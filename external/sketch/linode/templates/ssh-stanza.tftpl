%{ for middle in middles ~}
Host ${middle.label}
    User root
    IdentityFile ${ssh_private_key}
    Hostname ${middle.ip_address}
    ProxyJump proxy01-${engagement_name}

%{ endfor ~}
%{ for edge in edges ~}
Host ${edge.node.label}
    User root
    IdentityFile ${ssh_private_key}
    Hostname ${edge.node.ip_address}
    ProxyJump ${edge.middle_name}
%{ endfor ~}
