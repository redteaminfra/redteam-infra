# Copy to variables.tfvars and edit. Keep the token out of version control.
linode_api_token = ""
engagement_name = ""
linode_image    = ""
ssh_config_path = "~/.ssh"

# Optional new policy for a fresh disposable root: restrict public SSH/22 to
# verified management/jump-host IPv4 CIDRs. Leaving this unset preserves the
# traditional public TCP/22 rule. Do not guess or use a world CIDR here.
# trusted_ssh_cidrs = ["198.51.100.10/32"]

# Stable middle names are referenced by edge_groups.middle_node. The ordinal
# remains the familiar middle01/middle02 number in provider labels and SSH.
middles = {
  primary = { region = "us-east", ordinal = 1 }
}

# One edge in Newark, one in Fremont, and two in Seattle.
# Each group uses one concrete Linode region.
edge_groups = {
  newark  = { region = "us-east", middle_node = "primary", count = 1 }
  fremont = { region = "us-west", middle_node = "primary", count = 1 }
  seattle = { region = "us-sea", middle_node = "primary", count = 2 }
}

# Two groups in one region need disjoint ordinals; for example:
# second_seattle = { region = "us-sea", middle_node = "secondary", count = 2, ordinal_start = 3 }
# To retire us-sea-02 without renumbering us-sea-01, replace count with:
# seattle = { region = "us-sea", middle_node = "primary", ordinals = [1] }
# To add another edge later, use ordinals = [1, 3] so 02 remains retired.
# Keep explicit ordinals after retiring an edge; switching back to count can
# allocate that retired ordinal again.
# Set exactly one of count or ordinals per group.

# For a middle managed in another provider root, declare its logical name:
# external_middle_nodes = ["digitalocean-primary"]
# Then an edge group may use middle_node = "digitalocean-primary". Barragan
# assembles SSH/inventory artifacts for mixed-provider chains.

# If homebase used different SSH keys, set these paths:
# ssh_priv_key_path = "~/.ssh/engagement"
# ssh_pub_key_path  = "~/.ssh/engagement.pub"

# Legacy fresh-root form (do not combine with middles/edge_groups):
# middle_region = "us-east"
# middle_count = 1
# edge_regions = ["us-west", "us-sea"]
# edge_count_per_region = 2
