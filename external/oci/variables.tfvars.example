# Copyright (c) 2026, Oracle and/or its affiliates.

# Provider initialization
config_file_profile = ""

# Optional, default path is `~/.ssh`
#ssh_config_path              = ""

# Which compartment the infra be setup in:
compartment_id = ""

# If you would like to move backups to a different compartment specify the OCID here:
# backup_compartment_id = ""

# Which region
# https://docs.oracle.com/en-us/iaas/Content/General/Concepts/regions.htm
# use the Region Identifier, e.g: us-sanjose-1
region         = ""
# Which availability domain
ad_number      = "1"

# The engagement's name, infrastructure will be named after this
engagement_name = ""

# Select the current production bare-metal homebase with is_production = true.
# Development homebases use the Flex values below.
is_production             = false
production_homebase_shape = "BM.Standard3.64"
homebase_shape            = "VM.Standard.E4.Flex"
homebase_ocpus            = 16
homebase_memory_in_gbs    = 512

# Each proxy is sized independently from homebase.
proxy_shape         = "VM.Standard.E4.Flex"
proxy_ocpus         = 2
proxy_memory_in_gbs = 32
proxy_count         = 2

# ELK uses its own Flex allocation.
elk_shape         = "VM.Standard.E4.Flex"
elk_ocpus         = 2
elk_memory_in_gbs = 32

boot_volume_size_in_gbs = 512

# Set to IP's and/or IP ranges you would like to have SSH access to the infrastructure
# Each item in range should be an address range in cidr format
# e.g. ssh_allowed_cidr_ranges = ["192.168.32.0/25", "172.16.0.0/16"]
ssh_allowed_cidr_ranges = []
